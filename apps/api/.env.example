# Copy to .env and fill in locally. Never commit the real .env file.

PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to call this API (Donor web on 3000, Institution web on 3001).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Firebase Admin (server-side ID token verification).
# Optional for now — until these are set, auth endpoints respond with 503
# instead of crashing the server. Fill in once a Firebase project exists.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Sheets service account (the "Wafina Database" spreadsheet).
# Same story — optional until you share a service account on the real sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Google Drive (donation photos). MUST be a Shared Drive — plain service
# accounts have no storage quota and cannot own files anywhere else. Share
# the Shared Drive with the same service account above as Content Manager.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
