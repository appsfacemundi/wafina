{
  "expo": {
    "name": "Wafina Instituição",
    "slug": "wafina-institution",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zuinder.wafina.instituicao",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "A Wafina usa a sua localização para registar a localização da sua instituição.",
        "NSPhotoLibraryUsageDescription": "A Wafina precisa de acesso às suas fotografias para o logótipo e para Histórias de Impacto.",
        "NSCameraUsageDescription": "A Wafina precisa de acesso à câmara para tirar fotografias para Histórias de Impacto.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zuinder.wafina.instituicao",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#0057D9"
      }
    },
    "owner": "zuinder",
    "extra": {
      "eas": {
        "projectId": "0a4405fe-c166-4226-9b7d-f11abd9ed01c"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0057D9",
          "dark": {
            "image": "./assets/splash-mark.png",
            "backgroundColor": "#0F172A"
          }
        }
      ]
    ]
  }
}
