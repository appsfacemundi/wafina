# Copy to .env.local and fill in. These NEXT_PUBLIC_* Firebase values are
# client-side config, not secrets — Firebase's web SDK is designed to have
# them embedded in the shipped bundle (security is enforced by Firebase
# Auth + backend rules, not by hiding these values).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The Wafina API's base URL (apps/api). Local dev: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=
